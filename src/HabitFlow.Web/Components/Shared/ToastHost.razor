@implements IDisposable
@inject ToastService Toasts
@if (Toasts.Current is { } message)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3" aria-live="polite"><div class="toast show" role="status"><div class="toast-header"><strong class="me-auto">@(message.IsError ? "Please check" : "All set")</strong><button type="button" class="btn-close" aria-label="Dismiss notification" @onclick="Toasts.Dismiss"></button></div><div class="toast-body">@message.Text</div></div></div>
}
@code {
    protected override void OnInitialized() => Toasts.Changed += Update;
    private void Update() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Toasts.Changed -= Update;
}
