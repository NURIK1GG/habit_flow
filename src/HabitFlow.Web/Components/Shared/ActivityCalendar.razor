<div class="panel calendar-panel"><div class="section-heading"><h2>Show up for yourself</h2><span class="pill">Last 28 days</span></div><p class="muted small">A small mark. A meaningful commitment.</p><div class="activity-grid">@foreach (var day in Days) { <div class="activity-cell @(day.Completed > 0 ? day.Completed >= 3 ? "level-3" : "level-1" : "")" title="@($"{day.Date:MMM d}: {day.Completed} check-ins")" aria-label="@($"{day.Date:MMM d}: {day.Completed} check-ins")">@day.Date.Day</div> }</div><div class="calendar-legend"><span>Less</span><i></i><i class="level-1"></i><i class="level-3"></i><span>More</span></div></div>
@code { [Parameter] public IReadOnlyList<DayDto> Days { get; set; } = []; }
