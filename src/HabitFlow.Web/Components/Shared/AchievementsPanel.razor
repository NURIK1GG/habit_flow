<section class="panel achievements-panel" aria-labelledby="achievements-heading"><div class="section-heading"><div><h2 id="achievements-heading">Milestones that matter</h2><p class="muted small">Based on your current history. Every step counts.</p></div><span class="pill">@Items.Count(a => a.Unlocked) / @Items.Count earned</span></div><div class="achievement-grid">@foreach (var item in Items) { <article class="achievement @(item.Unlocked ? "earned" : "locked")" @key="item.Id"><div class="achievement-icon"><Icon Name="@item.Icon" Size="25" /></div><div><span class="achievement-status">@(item.Unlocked ? "EARNED" : "IN PROGRESS")</span><h3>@item.Title</h3><p>@item.Description</p><div class="goal-track" role="progressbar" aria-label="@item.Title" aria-valuenow="@Math.Min(item.Current, item.Target)" aria-valuemin="0" aria-valuemax="@item.Target"><div style="@($"width:{item.Percent}%")"></div></div><span class="muted small">@(item.Unlocked ? "✓ Milestone reached" : $"{item.Current} / {item.Target}")</span></div></article> }</div></section>
@code { [Parameter] public IReadOnlyList<AchievementDto> Items { get; set; } = []; }
