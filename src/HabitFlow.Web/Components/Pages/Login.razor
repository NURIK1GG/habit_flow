@page "/account/login"
@attribute [AllowAnonymous]
@inject IWebHostEnvironment Environment
<PageTitle>Sign in · HabitFlow</PageTitle>
<section class="auth-wrap"><div class="auth-story"><span class="eyebrow">WELCOME TO HABITFLOW</span><h1>Small steps.<br />Lasting change.</h1><p>Build routines that fit your life. Track the work, celebrate the progress, and grow together.</p><div class="quote-card">“You don't have to be extreme.<br />Just consistent.”</div></div>
<div class="panel auth-form"><h2>Good to see you.</h2><p class="muted">Sign in and keep your momentum going.</p>
@if (!string.IsNullOrEmpty(Error)) { <div class="alert alert-danger" role="alert">@Error</div> }
<form method="post" action="/auth/login" data-enhance="false"><AntiforgeryToken />
<label class="form-label" for="email">Email address</label><input id="email" name="email" type="email" class="form-control" required maxlength="254" autocomplete="username" />
<label class="form-label mt-3" for="password">Password</label><input id="password" name="password" type="password" class="form-control" required maxlength="128" autocomplete="current-password" />
<button type="submit" class="btn btn-primary w-100 mt-4">Sign in →</button></form>
<p class="mt-4 muted">New here? <a href="/account/register" data-enhance-nav="false">Create an account</a></p>
@if (Environment.IsDevelopment()) { <div class="demo-note"><strong>Explore the demo</strong><br />user@habitflow.local<br />Password: Demo!Pass123</div> }
</div></section>
@code { [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; } }
