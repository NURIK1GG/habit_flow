@page "/settings"
@inherits TrackerPage
@attribute [Authorize]
<PageTitle>Settings · HabitFlow</PageTitle>
<div class="page-heading"><div><div class="eyebrow">YOUR WORKSPACE, YOUR CHOICE</div><h1>Make yourself at home.</h1><p class="muted">Choose how you show up in the community.</p></div></div><StateBanner />
@if (State.Data is { } profileData) { model ??= new() { DisplayName = profileData.Profile.DisplayName, IsPublic = profileData.Profile.IsPublic, WeeklyGoal = profileData.Profile.WeeklyGoal }; <div class="panel settings-panel"><h2>Your profile</h2><EditForm Model="model" OnValidSubmit="Save" FormName="profile"><DataAnnotationsValidator /><fieldset disabled="@(State.IsBusy || !IsInteractive)"><ValidationSummary /><label class="form-label mt-3" for="display-name">Display name</label><InputText id="display-name" class="form-control" @bind-Value="model.DisplayName" maxlength="40" /><ValidationMessage For="() => model.DisplayName" /><label for="weekly-goal" class="form-label mt-3">Weekly check-in goal</label><InputNumber id="weekly-goal" class="form-control" @bind-Value="model.WeeklyGoal" min="1" max="100" /><ValidationMessage For="() => model.WeeklyGoal" /><p class="muted small mt-2">1–100 check-ins per week. Your week runs Monday–Sunday in Astana time. Changing this target updates the current week.</p><div class="privacy-option"><InputCheckbox id="public-profile" class="form-check-input" @bind-Value="model.IsPublic" /><div><label for="public-profile"><strong>Join the community leaderboard</strong></label><p class="muted small">Share your display name, monthly check-in count, total minutes and points with signed-in members. Your notes and routine details stay private.</p></div></div><button class="btn btn-primary" disabled="@(State.IsBusy || !IsInteractive)" type="submit">Save preferences</button></fieldset></EditForm></div><div class="settings-note"><h3>Your tracking timezone</h3><p>All dates and monthly leaderboards use Astana time (UTC+5), so everyone follows the same calendar. Archived routines keep their history and earned points.</p></div> }
@code {
    private ProfileEdit? model;
    protected override async Task OnInitializedAsync() { await base.OnInitializedAsync(); if (State.Data is { } data) model = new() { DisplayName = data.Profile.DisplayName, IsPublic = data.Profile.IsPublic, WeeklyGoal = data.Profile.WeeklyGoal }; }
    private Task Save() => Act(() => Tracker.SaveProfileAsync(model!), "Your preferences are saved.");
}
